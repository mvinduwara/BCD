<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Resource Definitions//EN" "https://glassfish.org/dtds/glassfish-resources_1_5.dtd">
<resources>
    <jdbc-connection-pool
            name="scmConnectionPool"
            datasource-classname="com.mysql.cj.jdbc.MysqlDataSource"
            res-type="javax.sql.DataSource"
            is-connection-validation-required="true"
            connection-validation-method="auto-commit"
            max-pool-size="32"
            steady-pool-size="8"
            transaction-isolation-level="read-committed"
            is-isolation-level-guaranteed="true">
        <property name="serverName" value="localhost"/>
        <property name="portNumber" value="3306"/>
        <property name="databaseName" value="scm_db"/>
        <property name="user" value="scm_app"/>
        <property name="password" value="change_me"/>
        <property name="useSSL" value="false"/>
        <property name="allowPublicKeyRetrieval" value="true"/>
        <property name="serverTimezone" value="UTC"/>
    </jdbc-connection-pool>
    <jdbc-resource
            pool-name="scmConnectionPool"
            jndi-name="jdbc/scmDS"/>
</resources>