<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="TechMartPU" transaction-type="JTA">
        <jta-data-source>jdbc/TechMartDS</jta-data-source>

        <class>com.techmart.model.Product</class>
        <class>com.techmart.model.Order</class>
        <class>com.techmart.model.OrderItem</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="eclipselink.logging.level" value="WARNING"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.cache.shared.default" value="false"/>
            <property name="eclipselink.jdbc.batch-writing" value="JDBC"/>
            <property name="eclipselink.jdbc.batch-writing.size" value="100"/>
        </properties>
    </persistence-unit>

</persistence>